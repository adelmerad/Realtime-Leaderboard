# PostgreSQL — matches docker-compose.yml
DATABASE_URL="postgresql://leaderboard:leaderboard@localhost:5434/leaderboard?schema=public"

# Optional: direct (non-pooled) connection used for LISTEN/NOTIFY.
# Needed with connection poolers such as Neon "-pooler" URLs, which do not support LISTEN.
# LISTEN_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs the admin session cookie — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Password for the admin dashboard
ADMIN_PASSWORD="change-me"
