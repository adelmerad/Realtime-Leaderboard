# PostgreSQL — matches docker-compose.yml
# Pooled connection used by the app (on Neon: the host with "-pooler")
DATABASE_URL="postgresql://leaderboard:leaderboard@localhost:5434/leaderboard?schema=public"
# Direct connection used for migrations and LISTEN/NOTIFY (locally the same database)
DATABASE_URL_UNPOOLED="postgresql://leaderboard:leaderboard@localhost:5434/leaderboard?schema=public"

# Signs the admin session cookie — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Password for the admin dashboard
ADMIN_PASSWORD="change-me"
